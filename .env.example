# Golden Mind Psychiatry PLLC — Environment, Auth, Database & SMTP Configuration
# Before connecting your domain name, set APP_URL to your Ubuntu Server IP:
# Example: APP_URL="http://YOUR_SERVER_IP:3000"
# After connecting your domain name, change it to:
APP_URL="https://goldenmindpsychiatry.org"
PORT="3000"
NODE_ENV="production"

# ============================================================================
# 1. SMTP MAIL SERVER SETTINGS (BusinessIdentity.llc / Clinic Email)
# ============================================================================
SMTP_HOST="mailserver.businessidentity.llc"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@goldenmindpsychiatry.org"
SMTP_PASS=""
SMTP_FROM="Golden Mind Psychiatry PLLC <info@goldenmindpsychiatry.org>"
DOCTOR_NOTIFICATION_EMAIL="info@goldenmindpsychiatry.org"

# ============================================================================
# 2. SELF-HOSTED UBUNTU DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
DATABASE_URL="postgresql://goldenmind_admin:CHANGE_THIS_DB_PASSWORD@127.0.0.1:5432/goldenmind_db"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="goldenmind_db"
DB_USER="goldenmind_admin"
DB_PASSWORD=""

# ============================================================================
# 3. AUTHENTICATION, JWT SESSION & ACCOUNT LOCKOUT SECRETS
# ============================================================================
JWT_SECRET=""
RESET_HMAC_SECRET=""
SESSION_EXPIRES_DAYS="30"
AUTH_MAX_LOGIN_ATTEMPTS="5"
AUTH_LOCKOUT_MINUTES="15"
AUTHORIZED_ADMIN_EMAILS="info@goldenmindpsychiatry.org,beehobs@yahoo.com,chibundusadiq@gmail.com,brenda@goldenmindpsychiatry.org"

# ============================================================================
# 4. OAUTH SIGN-IN PROVIDERS (Google, Yahoo, Microsoft/Outlook, Facebook, X)
# ============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YAHOO_CLIENT_ID=""
YAHOO_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

